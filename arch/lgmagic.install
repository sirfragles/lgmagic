# lgmagic.install - pacman hooks for the DKMS module, tmpfiles and udev.
# Every DKMS step is best-effort: a machine without matching kernel
# headers (or with Secure Boot rejecting the unsigned module) must never
# get a broken package transaction. The daemon itself is enabled by the
# setup wizard, not here.

# Pacman sources this file and calls the functions with $1/$2 set; the
# file itself has no shebang.  post_install() intentionally reads $2 (and
# post_upgrade() calls it bare, so its own positional parameters carry
# through) - the pacman .install contract, not an argument bug.
# shellcheck shell=sh
# shellcheck disable=SC2119,SC2120

post_install() {
  # The DKMS module version follows the package version (pacman passes
  # pkgver-pkgrel as $2; shared with post_upgrade below, which calls
  # post_install without resetting the positional parameters).
  V=${2%%-*}
  # Create the daemon state directory (/var/lib/lgmagic).
  systemd-tmpfiles --create lgmagic.conf || true
  if command -v dkms >/dev/null 2>&1; then
    dkms add -m lgmagic -v "$V" || :
    dkms build -m lgmagic -v "$V" || :
    dkms install -m lgmagic -v "$V" || :
  fi
  udevadm control --reload-rules || true
  udevadm trigger || true
}

post_upgrade() {
  post_install
}

pre_remove() {
  # Still installed while pre_remove runs, so $2 carries the version.
  V=${2%%-*}
  if command -v dkms >/dev/null 2>&1; then
    dkms remove -m lgmagic -v "$V" --all || :
  fi
}

post_remove() {
  udevadm control --reload-rules || true
}
