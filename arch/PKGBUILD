# Maintainer: sirfragles <sirfragles@users.noreply.github.com>

pkgname=lgmagic
pkgver=0.0.1
pkgrel=1
pkgdesc="LG Magic Remote MR20 driver, daemon and tools"
# x86_64 only for now: the airmouse filter uses FP math, which arm64
# kbuild forbids by default (-mgeneral-regs-only; CC_FLAGS_FPU is an
# x86-ism). Re-add 'aarch64' once the filter is integer math.
arch=('x86_64')
url="https://github.com/sirfragles/lgmagic"
license=('GPL-2.0-or-later')
depends=('dkms' 'polkit' 'systemd-libs')
makedepends=('gcc' 'make' 'pkgconf' 'systemd')
install=lgmagic.install
source=("lgmagic-$pkgver.tar.gz::https://github.com/sirfragles/lgmagic/archive/refs/tags/v$pkgver.tar.gz")
# CI pre-seeds SRCDEST from the checkout; the URL serves direct builds.
sha256sums=('SKIP')
backup=('etc/lgmagic/config.toml')

build() {
  cd "$srcdir/lgmagic-$pkgver"
  make tools
}

package() {
  cd "$srcdir/lgmagic-$pkgver"
  make install DESTDIR="$pkgdir" PREFIX=/usr \
      UDEV_DIR=/usr/lib/udev/rules.d \
      UNIT_DIR=/usr/lib/systemd/system \
      TMPFILES_DIR=/usr/lib/tmpfiles.d
  # Arch has no /usr/libexec: patch the unit and install the daemon into
  # /usr/lib instead.
  sed -i 's|ExecStart=/usr/libexec/lgmagicd|ExecStart=/usr/lib/lgmagicd|' \
      "$pkgdir/usr/lib/systemd/system/lgmagicd.service"
  install -Dm 0755 tools/lgmagicd "$pkgdir/usr/lib/lgmagicd"
  # The DKMS tree: dkms.conf + the module sources.
  install -d "$pkgdir/usr/src/lgmagic-$pkgver"
  cp -r kernel include "$pkgdir/usr/src/lgmagic-$pkgver/"
  install -m 644 Makefile COPYING dkms.conf \
      "$pkgdir/usr/src/lgmagic-$pkgver/"
}
